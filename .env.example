# Copy to .env for local testing. NEVER commit real secrets (.env is in .gitignore).
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=postgresql://user:password@host:5432/dbname     (Render PostgreSQL in production)

# --- AI Mentor: set ONE of the two keys ---
ENABLE_AI_MENTOR=true
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini            # only needed if you set both keys (gemini or claude)
# Optional model overrides (check the current model names in Google AI Studio / the Anthropic console):
# GEMINI_MODEL_FREE=gemini-2.5-flash
# GEMINI_MODEL_PREMIUM=gemini-2.5-pro
# ANTHROPIC_MODEL_FREE=claude-haiku-5-5
# ANTHROPIC_MODEL_PREMIUM=claude-sonnet-5-5

# --- Razorpay (use TEST keys until everything is verified) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
